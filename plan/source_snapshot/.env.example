TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Optional overrides
UNIVERSE=NIFTY100          # NIFTY50 | NIFTY100 | NIFTY200 | NIFTY500 | comma-separated symbols
SCAN_INTERVAL_MIN=15
TIMEFRAME=1d               # 1d (swing) or 15m / 5m (intraday)
MIN_SCORE=2                # number of agreeing strategies required to alert
CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
ALLOW_SHORTS=false         # true to also get SELL/short suggestions
STRATEGIES=                # comma-separated; empty = all except opt-in ones (Squeeze Breakout, RSI(2) Reversion)
FILTERS=                   # trend, rs (market above its 200 EMA / stock beating the index); empty = none

# US market (dashboard US tab)
US_UNIVERSE=SP100          # SP100 | SP500 | comma-separated tickers
US_CAPITAL=10000           # in dollars
