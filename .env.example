TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Optional: real-time NSE prices from Kotak Neo (Neo app > More > Trade API). Only this key is needed;
# never put your password, MPIN or TOTP secret here.
KOTAK_CONSUMER_KEY=

# Kotak trading login (for order placement; run.bat --kotak-check to test). Anyone who can read this file can
# trade the account: keep .env private and never share or commit it.
KOTAK_MOBILE=              # registered mobile with country code, e.g. +919876543210
KOTAK_UCC=                 # client code (Neo app > Profile)
KOTAK_MPIN=
KOTAK_TOTP_SECRET=         # base32 key shown when registering TOTP (the text behind the QR code)
DASHBOARD_PIN=             # phone app login (6+ digits); empty = only this PC can open the dashboard
MAX_ORDERS_PER_DAY=2       # hard caps on automatic orders; trading is switched on / off on the dashboard
MAX_ORDER_VALUE=10000      # ₹ per order
OPTIONS_MAX_LOTS=10        # manual option orders (dashboard Strategy Builder tab): max lots per order
STOCK_MAX_ORDER_VALUE=100000  # manual stock buys (dashboard Portfolio): max ₹ per order
MARKET_PROTECTION_PCT=1.0  # "market" orders go in as a limit this % past the live price (SEBI: no API market orders)
OPTION_PROTECTION_PCT=5.0  # the same for option orders (wider: option prices move faster)
MAX_OPEN_RISK_PCT=6.0      # Auto-trade opens no trade that takes total risk at stops above this % of CAPITAL
DAILY_SUMMARY=true         # Telegram summary after the NSE close
LIVE_FEED=true            # stream live prices from Kotak (WebSocket) in the dashboard
DB_BACKUP=false           # daily copy of signals.db to data/backups + Telegram (off)
TELEGRAM_COMMANDS=true     # answer /positions, /pnl, /stop ... in the Telegram group
EVENT_WINDOW_DAYS=3        # "Events" scan filter: skip stocks with results / ex-dividend within this many days

# Optional overrides
UNIVERSE=NIFTY100          # NIFTY50 | NIFTY100 | NIFTY200 | NIFTY500 | comma-separated symbols
SCAN_INTERVAL_MIN=15
TIMEFRAME=1d               # 1d (swing) or 15m / 5m (intraday)
MIN_SCORE=2                # number of agreeing strategies required to alert
CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
ALLOW_SHORTS=false         # true to also get SELL/short suggestions
STRATEGIES=                # comma-separated; empty = all except opt-in ones (Squeeze Breakout, RSI(2) Reversion)
FILTERS=                   # trend, rs (market above its 200 EMA / stock beating the index); empty = none

# Per-market scanner settings (empty = use STRATEGIES / MIN_SCORE / FILTERS above)
STRATEGIES_IN=RSI Pullback,RSI(2) Reversion   # best India setup after costs (see README Notes)
MIN_SCORE_IN=1
FILTERS_IN=trend,rs
STRATEGIES_US=
MIN_SCORE_US=
FILTERS_US=

# Backtest costs (see README "Backtest costs")
BROKERAGE=20               # ₹ per order
DP_CHARGE=20               # ₹ per delivery sale, incl. GST
SLIPPAGE_BPS=5             # basis points on market-type fills
US_BROKERAGE=0             # $ per order
US_SLIPPAGE_BPS=2

# US market (dashboard US tab)
US_UNIVERSE=SP100          # SP100 | SP500 | comma-separated tickers
US_CAPITAL=10000           # in dollars
